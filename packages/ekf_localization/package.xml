<?xml version="1.0"?>
<package format="3">
  <name>ekf_localization</name>
  <version>2.0.0</version>
  <description>EKF localization of the Duckiebot from wheel encoders and AprilTag landmarks (ROS 2).</description>
  <maintainer email="liam@duckietown.com">Liam P</maintainer>
  <license>GPLv3</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>lx_ros2_tools</exec_depend>
  <exec_depend>encoder_pose</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
